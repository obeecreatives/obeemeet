# LiveKit Cloud / Self-Hosted LiveKit Server Credentials (Server-side only)
# Dapatkan gratis di https://cloud.livekit.io lalu masukkan di Vercel Environment Variables
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"

# Opsional: Kunci penandatanganan sesi Host (jika kosong, otomatis memakai turunan LIVEKIT_API_SECRET)
HOST_SESSION_SECRET=""

# APP_URL: URL aplikasi saat di-deploy
APP_URL="http://localhost:3000"
